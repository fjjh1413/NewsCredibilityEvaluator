SECRET_KEY=replace_with_at_least_32_random_characters
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
MYSQL_PASSWORD=replace_with_app_mysql_password
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=replace_with_admin_password
FIRST_SUPERUSER_EMAIL=admin@example.com

# Production HTTPS and observability
DOMAIN=example.com
ACME_EMAIL=ops@example.com
LOG_LEVEL=INFO
PROMETHEUS_RETENTION=15d
OTEL_TRACING_ENABLED=true
OTEL_SERVICE_NAME=newscred-backend
OTEL_TRACE_SAMPLE_RATIO=0.10
PYROSCOPE_ENABLED=true
PYROSCOPE_REQUIRED=false
PYROSCOPE_APPLICATION_NAME=newscred
PYROSCOPE_SAMPLE_RATE=100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_password
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_feishu_bot_token
FEISHU_ALERT_TITLE=NewsCred 告警

# Optional external service keys. Keep placeholders for disabled integrations.
DASHSCOPE_API_KEY=replace_with_dashscope_api_key
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
BOCHA_API_KEY=replace_with_bocha_api_key

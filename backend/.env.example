PROJECT_NAME=zhiyun-bianzhen-backend
PROJECT_VERSION=0.1.0
API_PREFIX=/api
APP_ENV=development
BACKEND_CORS_ORIGINS=*

# MySQL 数据库配置
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=123456
DATABASE_NAME=zhiyun_bianzhen

# JWT 身份验证配置。本地开发时请用长随机字符串替换密钥，切勿使用默认值
# 生产环境请使用至少 32 字符的随机字符串，不要使用 change_me、replace_with_secret_key、your-secret-key 等占位符
SECRET_KEY=replace_with_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 执行命令 python -m app.db.init_db 时会自动创建该超级管理员账号，替换下面的值以设置管理员账号信息。
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=replace_with_admin_password
FIRST_SUPERUSER_EMAIL=admin@example.com

# Chroma 向量数据库持久化配置.
# 相对路径从后端根目录开始解析.
# 本地演示推荐使用 ../data/chroma，将向量数据存储在后端源码目录外.
CHROMA_PERSIST_DIR=../data/chroma

# RAG embedding configuration.
# Formal RAG / defense demos should use dashscope semantic embeddings.
# - dashscope: calls DashScope text-embedding-v4 through the OpenAI-compatible API.
# - hash: deterministic local demo fallback, not semantic. Use only when no API key is available.
# - deepseek: legacy provider kept for compatibility if explicitly configured.
# - local: reserved for future local embedding models.
# IMPORTANT: when switching provider, you MUST also update EMBEDDING_DIMENSION to
# match the model output (e.g. 1024 for text-embedding-v4) and rebuild the
# Chroma knowledge vector index to avoid dimension mismatch errors or stale retrieval.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_DIMENSION=1024

# DashScope embedding model name. Only used when EMBEDDING_PROVIDER=dashscope.
# text-embedding-v4 defaults to 1024-dim vectors; keep EMBEDDING_DIMENSION in sync.
DASHSCOPE_API_KEY=replace_with_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# DashScope embedding API timeout in seconds (default: 30).
DASHSCOPE_EMBEDDING_TIMEOUT_SECONDS=30

# DeepSeek embedding model name. Only used when EMBEDDING_PROVIDER=deepseek.
# deepseek-embedding-v1 outputs 1024-dim vectors; keep EMBEDDING_DIMENSION in sync.
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding-v1
# DeepSeek embedding API timeout in seconds (default: 30).
DEEPSEEK_EMBEDDING_TIMEOUT_SECONDS=30

# PDF 报告输出目录.
# 必须指向后端源码目录之外，否则项目启动 / 报告生成会失败.
REPORT_DIR=../data/reports

# 新闻检测接口 IP 频率限制.
# 默认每个 IP 每 60 秒最多允许 3 次 /detect/news 请求.
# 测试环境可临时调小窗口，便于验证窗口期恢复.
DETECT_RATE_LIMIT_COUNT=3
DETECT_RATE_LIMIT_WINDOW_SECONDS=60

# Redis 缓存与分布式限流配置.
# 开发环境可保持 REDIS_ENABLED=false；企业级生产部署建议启用 Redis，并设置 REDIS_REQUIRED=true 让 readiness 严格检查.
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=1
CACHE_KEY_PREFIX=newscred
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_TTL_JITTER_SECONDS=30
ADMIN_STATISTICS_CACHE_TTL_SECONDS=60

# 异步检测任务队列。开发默认关闭以保持同步调试；生产可开启并启动 Celery worker。
ASYNC_DETECTION_ENABLED=false
ASYNC_TASK_ALWAYS_EAGER=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_WORKER_CONCURRENCY=2

# 重任务结果缓存。仅在 REDIS_ENABLED=true 时生效。
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
WEB_SEARCH_CACHE_ENABLED=true
WEB_SEARCH_CACHE_TTL_SECONDS=900
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=86400
REPORT_GENERATION_CACHE_ENABLED=true

# RAG v2 retrieval. Code defaults to v1 for rollback safety; switch explicitly
# after rebuilding the v2 chunk index and validating retrieval metrics.
# v1: one vector per knowledge item
# v2: chunk-level dense + lexical retrieval
# hybrid: use v2 first and fall back to v1 if v2 returns no evidence
RAG_INDEX_VERSION=v1
RAG_RETRIEVAL_DEBUG=false
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_DENSE_TOP_N=50
RAG_PARENT_TOP_K=15
RAG_CHUNKS_PER_PARENT=2
RAG_LEXICAL_ENABLED=true
RAG_MMR_ENABLED=true

# OpenTelemetry tracing. Keep disabled for ordinary local development.
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=newscred-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACE_SAMPLE_RATIO=0.10

# Pyroscope continuous profiling. Local development stays disabled by default.
# pyroscope-io is skipped on Windows by dependency marker; use Docker/Linux for profiling.
PYROSCOPE_ENABLED=false
PYROSCOPE_REQUIRED=false
PYROSCOPE_SERVER_ADDRESS=http://127.0.0.1:4040
PYROSCOPE_APPLICATION_NAME=newscred
PYROSCOPE_SAMPLE_RATE=100
PYROSCOPE_BASIC_AUTH_USERNAME=
PYROSCOPE_BASIC_AUTH_PASSWORD=
PYROSCOPE_TENANT_ID=

# DeepSeek 大模型配置.这些变量会被 app/services/llm_service.py 读取使用
# 切勿提交真实的 API 密钥到代码仓库.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=30

# ──────────────────────────────────────────────────────────────
# Bocha AI 联网搜索配置
# ──────────────────────────────────────────────────────────────
# Bocha Web Search API Key. 从 https://open.bochaai.com/ 获取.
# 未配置时，联网检索和定时抓取功能将被禁用.
BOCHA_API_KEY=replace_with_bocha_api_key
BOCHA_API_BASE_URL=https://api.bochaai.com

# 实时联网检索（检测时按需触发）
# 全局开关：设为 false 可在紧急情况下全局关闭联网检索
WEB_SEARCH_ENABLED=true
# 搜索时间范围：noLimit / oneDay / oneWeek / oneMonth / oneYear
WEB_SEARCH_FRESHNESS=oneMonth
# 单次联网搜索返回条数 (1-50)
WEB_SEARCH_COUNT=5
# 联网搜索 API 超时秒数
WEB_SEARCH_TIMEOUT_SECONDS=8

# 定时抓取新闻进知识库
# 全局开关：设为 false 停止所有定时抓取
CRAWL_ENABLED=true
# Cron 表达式控制抓取频率（默认每 6 小时）
CRAWL_SCHEDULE=0 */6 * * *
# 全文抓取并发数（同时抓取几篇网页）
CRAWL_CONCURRENT_FETCHES=3
# 单篇全文抓取超时
CRAWL_FETCH_TIMEOUT_SECONDS=10
# 单篇网页最大抓取字节数 (默认 2MB)
CRAWL_FETCH_MAX_BYTES=2097152
# 是否允许抓取私有/内网地址（生产环境必须设为 false）
CRAWL_ALLOW_PRIVATE_HOSTS=false
# 抓取后是否自动向量化（关闭则仅写入 MySQL，不写入 Chroma）
CRAWL_AUTO_SYNC_VECTOR=true

# 链接识别：检测页粘贴新闻链接 → 服务端抓取并提取标题/正文 → 回填表单
# SSRF default-deny：默认拒绝抓取私有/内网地址；仅本地联调时设为 true
ARTICLE_FETCH_ALLOW_PRIVATE_HOSTS=false

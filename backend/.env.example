PROJECT_NAME=zhiyun-bianzhen-backend
PROJECT_VERSION=0.1.0
API_PREFIX=/api
APP_ENV=development
BACKEND_CORS_ORIGINS=*

# MySQL 数据库配置
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=123456
DATABASE_NAME=zhiyun_bianzhen

# JWT 身份验证配置。本地开发时请用长随机字符串替换密钥，切勿使用默认值
# 生产环境请使用至少 32 字符的随机字符串，不要使用 change_me、replace_with_secret_key、your-secret-key 等占位符
SECRET_KEY=replace_with_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 执行命令 python -m app.db.init_db 时会自动创建该超级管理员账号，替换下面的值以设置管理员账号信息。
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=replace_with_admin_password
FIRST_SUPERUSER_EMAIL=admin@example.com

# Chroma 向量数据库持久化配置.
# 相对路径从后端根目录开始解析.
# 本地演示推荐使用 ../data/chroma，将向量数据存储在后端源码目录外.
CHROMA_PERSIST_DIR=../data/chroma

# RAG embedding configuration.
# hash is a deterministic demo fallback that keeps Chroma writes/searches runnable.
# It is not semantic and is not suitable for production retrieval quality.
# deepseek/local are reserved for real embedding clients and must be implemented
# before enabling them. Keep the dimension unchanged for an existing Chroma
# collection unless you rebuild the knowledge vector index.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=384

# PDF 报告输出目录.
# 必须指向后端源码目录之外，否则项目启动 / 报告生成会失败.
REPORT_DIR=../data/reports

# 新闻检测接口 IP 频率限制.
# 默认每个 IP 每 60 秒最多允许 3 次 /detect/news 请求.
# 测试环境可临时调小窗口，便于验证窗口期恢复.
DETECT_RATE_LIMIT_COUNT=3
DETECT_RATE_LIMIT_WINDOW_SECONDS=60

# DeepSeek 大模型配置.这些变量会被 app/services/llm_service.py 读取使用
# 切勿提交真实的 API 密钥到代码仓库.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=30
